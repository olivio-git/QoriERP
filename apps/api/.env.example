# =============================================================
# QoriERP — Variables de entorno
# Copiar a .env y ajustar según el modo de despliegue
# =============================================================

# -------------------------------------------------------------
# MODO DE DESPLIEGUE
# "saas"        → proveedor hostea, múltiples tenants
# "self-hosted" → cliente instala en su VPS, un solo tenant
# -------------------------------------------------------------
DEPLOYMENT_MODE="self-hosted"

# -------------------------------------------------------------
# BASE DE DATOS
# -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/qorierp"

# -------------------------------------------------------------
# JWT
# Generar JWT_SECRET con: openssl rand -hex 64
# -------------------------------------------------------------
JWT_SECRET="change-me-use-openssl-rand-hex-64"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

# -------------------------------------------------------------
# REGISTRO DE TENANTS
# self-hosted → false  (primer usuario via POST /setup)
# saas        → true   (clientes se registran via POST /auth/register)
# -------------------------------------------------------------
ALLOW_REGISTRATION="false"

# -------------------------------------------------------------
# SEGURIDAD
# Recomendado: 12 en producción, 10 en desarrollo (tests más rápidos)
# -------------------------------------------------------------
BCRYPT_ROUNDS="12"

# -------------------------------------------------------------
# SERVIDOR
# -------------------------------------------------------------
PORT="3000"
NODE_ENV="production"
APP_VERSION="0.1.0"

# =============================================================
# REFERENCIA RÁPIDA POR MODO
#
# Self-hosted (cliente con licencia):
#   DEPLOYMENT_MODE="self-hosted"
#   ALLOW_REGISTRATION="false"
#   → Primera instalación: POST /setup
#   → Login sin tenantSlug
#
# SaaS (proveedor):
#   DEPLOYMENT_MODE="saas"
#   ALLOW_REGISTRATION="true"
#   → Registro de tenants: POST /auth/register
#   → Login con tenantSlug requerido
# =============================================================
